---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getNotes, formatDate, readingTime, type Note } from '../../lib/notes';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: { note, newer: notes[i - 1], older: notes[i + 1] },
  }));
}

interface Props {
  note: Note;
  newer?: Note;
  older?: Note;
}

const { note, newer, older } = Astro.props;
const { Content } = await render(note);
const { title, description, date, updated, tags, draft } = note.data;
---

<BaseLayout title={title} description={description} type="article" publishedTime={date}>
  <article class="post container">
    <a class="back" href="/notes/"><Icon name="arrow-left" /> All notes</a>

    <header class="post-head">
      <p class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>·</span>
        <span>{readingTime(note.body)}</span>
        {updated && <span>· Updated {formatDate(updated, 'short')}</span>}
        {draft && <span class="draft">Draft, only visible in dev</span>}
      </p>
      <h1>{title}</h1>
      <p class="post-desc">{description}</p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((t) => (
              <li class="chip">#{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="More notes">
      {
        older ? (
          <a class="card" href={`/notes/${older.id}/`}>
            <span>Older</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        newer && (
          <a class="card newer" href={`/notes/${newer.id}/`}>
            <span>Newer</span>
            {newer.data.title}
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: calc(720px + var(--gutter) * 2);
    padding-block: clamp(7.5rem, 6rem + 5vw, 10rem) var(--section-space);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-2);
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--text);
  }

  .back :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.5s var(--spring);
  }

  .back:hover :global(svg) {
    transform: translateX(-3px);
  }

  .post-head {
    margin: 2.5rem 0 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-3);
  }

  .draft {
    margin-left: 0.4rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    color: var(--accent);
    background: var(--accent-soft);
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 1.5rem + 3.2vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .post-desc {
    margin-top: 1rem;
    font-size: var(--fs-xl);
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--text-2);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.5rem;
    list-style: none;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 4rem;
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem 1.5rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    transition: transform 0.6s var(--spring);
  }

  .pager a:hover {
    transform: translateY(-3px);
  }

  .pager span {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-3);
  }

  .newer {
    text-align: right;
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
