---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getNotes, formatDate, readingTime } from '../../lib/notes';

const notes = await getNotes();
---

<BaseLayout title="Notes" description="Thoughts and things I’m learning along the way.">
  <section class="notes-page container">
    <header class="section-head" data-reveal>
      <p class="eyebrow"><b>Notes</b>Archive</p>
      <h1 class="section-title">
        Notes. <span class="muted">Thoughts and things I’m learning along the way.</span>
      </h1>
    </header>

    {
      notes.length === 0 ? (
        <p class="empty card" data-reveal>
          Nothing here yet. The first note is on its way.
        </p>
      ) : (
        <ol class="list">
          {notes.map((note, i) => (
            <li data-reveal style={`--d:${Math.min(i, 6) * 60}`}>
              <a class="row" href={`/notes/${note.id}/`}>
                <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date, 'short')}</time>
                <span class="text">
                  <span class="title">
                    {note.data.title}
                    {note.data.draft && <span class="draft">Draft</span>}
                  </span>
                  <span class="desc">{note.data.description}</span>
                </span>
                <span class="meta">{readingTime(note.body)}</span>
                <Icon name="arrow-right" class="arrow" />
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</BaseLayout>

<style>
  .notes-page {
    max-width: calc(900px + var(--gutter) * 2);
    min-height: 80svh;
    padding-block: clamp(8rem, 6rem + 6vw, 11rem) var(--section-space);
  }

  .empty {
    padding: 2rem;
    color: var(--text-2);
  }

  .list {
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto 20px;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.5rem 0.75rem;
    border-bottom: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition: background-color 0.25s ease;
  }

  .row:hover {
    background: var(--surface-2);
  }

  time,
  .meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-3);
    white-space: nowrap;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .title {
    font-size: var(--fs-xl);
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .draft {
    margin-left: 0.6rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    vertical-align: middle;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--accent);
    background: var(--accent-soft);
  }

  .desc {
    color: var(--text-2);
  }

  .row :global(.arrow) {
    width: 18px;
    height: 18px;
    align-self: center;
    color: var(--text-3);
    transition: transform 0.5s var(--spring);
  }

  .row:hover :global(.arrow) {
    transform: translateX(4px);
    color: var(--text);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr) 20px;
      gap: 0.4rem 1rem;
    }

    .row time {
      grid-column: 1 / -1;
    }

    .meta {
      display: none;
    }
  }
</style>
