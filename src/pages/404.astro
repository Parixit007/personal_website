---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ghost from '../components/Ghost.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" description="This page vanished.">
  <section class="lost container">
    <div class="lost-ghost">
      <Ghost size={150} interactive />
    </div>
    <p class="code">404</p>
    <h1>Boo! This page vanished.</h1>
    <p class="lead">It doesn’t exist, or it’s hiding really well.</p>
    <a class="btn btn-primary" href="/"><Icon name="arrow-left" /> Back home</a>
  </section>
</BaseLayout>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding-block: 7rem 4rem;
    text-align: center;
  }

  .lost-ghost {
    animation: haunt 5s ease-in-out infinite;
  }

  .code {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.3em;
    color: var(--accent);
  }

  h1 {
    margin-top: 0.75rem;
    font-size: var(--fs-section);
    letter-spacing: -0.05em;
  }

  .lead {
    margin: 1rem 0 2rem;
    font-size: var(--fs-lg);
    color: var(--text-2);
  }

  @keyframes haunt {
    0%,
    100% {
      transform: translate(0, 0) rotate(-3deg);
    }
    50% {
      transform: translate(0, -16px) rotate(3deg);
    }
  }
</style>
