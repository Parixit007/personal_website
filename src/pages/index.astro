---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Work from '../components/Work.astro';
import Journey from '../components/Journey.astro';
import Skills from '../components/Skills.astro';
import NotesPreview from '../components/NotesPreview.astro';
import Contact from '../components/Contact.astro';
import { getNotes } from '../lib/notes';
import { site } from '../data/site';

const notes = await getNotes();
const hasNotes = notes.length > 0;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  description: site.description,
  address: { '@type': 'PostalAddress', addressLocality: 'New Delhi', addressCountry: 'IN' },
  affiliation: { '@type': 'CollegeOrUniversity', name: site.education.school },
  sameAs: [site.socials.github, site.socials.linkedin],
  knowsAbout: ['Agentic AI', 'Computer vision', 'Python', 'TypeScript', 'FastAPI', 'React', 'PyTorch'],
};
---

<BaseLayout jsonLd={jsonLd}>
  <Hero />
  <About />
  <Work />
  <Journey />
  <Skills />
  {hasNotes && <NotesPreview notes={notes} num="05" />}
  <Contact num={hasNotes ? '06' : '05'} />
</BaseLayout>
