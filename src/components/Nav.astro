---
import Ghost from './Ghost.astro';
import ThemeToggle from './ThemeToggle.astro';
import { sections } from '../data/site';
import { getNotes } from '../lib/notes';

const notes = await getNotes();
const isHome = Astro.url.pathname === '/';
const onNotes = Astro.url.pathname.startsWith('/notes');

const links = sections
  .filter((s) => s.id !== 'notes' || notes.length > 0)
  .map((s) => ({
    ...s,
    href: s.id === 'notes' && !isHome ? '/notes' : `/#${s.id}`,
    current: s.id === 'notes' && onNotes,
  }));
---

<header class="nav-wrap" data-nav>
  <nav class="nav" aria-label="Primary">
    <a class="brand" href="/" aria-label="Parixit Singh Balot, home">
      <Ghost size={24} class="brand-ghost" />
      <span class="brand-name">Parixit</span>
    </a>

    <div class="nav-links-wrap">
      <span class="nav-indicator" aria-hidden="true" data-nav-indicator></span>
      <ul class="nav-links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} data-nav-link={l.id} aria-current={l.current ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="nav-actions">
      <ThemeToggle />
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-toggle
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <div class="mobile-menu glass" id="mobile-menu" data-menu>
    <ul>
      {
        links.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} data-menu-link>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .nav-wrap {
    position: fixed;
    inset: var(--nav-top) 0 auto;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding-inline: var(--gutter);
    pointer-events: none;
    /* No view-transition-name here: it would make this a backdrop root and stop the glass blurring the page. */
  }

  .nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: min(100%, 780px);
    height: 54px;
    padding: 0 7px 0 14px;
    border-radius: 999px;
    background: var(--glass);
    border: 1px solid var(--glass-border);
    box-shadow:
      inset 0 1px 0 var(--glass-rim),
      inset 0 -1px 0 var(--glass-edge),
      var(--shadow-sm);
    -webkit-backdrop-filter: blur(24px) saturate(190%);
    backdrop-filter: blur(24px) saturate(190%);
    transition:
      background-color 0.4s ease,
      box-shadow 0.4s ease,
      width 0.7s var(--spring);
  }

  .nav-wrap.is-scrolled .nav {
    background: var(--glass-strong);
    box-shadow:
      inset 0 1px 0 var(--glass-rim),
      inset 0 -1px 0 var(--glass-edge),
      var(--shadow-md);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 6px 4px;
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .brand :global(.brand-ghost) {
    transition: transform 0.6s var(--spring-bouncy);
  }

  .brand:hover :global(.brand-ghost) {
    transform: rotate(-10deg) translateY(-2px) scale(1.08);
  }

  .nav-links-wrap {
    position: relative;
  }

  .nav-links {
    display: flex;
    gap: 2px;
    list-style: none;
  }

  .nav-links a {
    position: relative;
    z-index: 1;
    display: block;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.25s ease;
  }

  .nav-links a:hover,
  .nav-links a.is-active,
  .nav-links a[aria-current='page'] {
    color: var(--text);
  }

  /* A little lens of glass that glides to the active section. */
  .nav-indicator {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: var(--w, 0px);
    transform: translateX(var(--x, 0px));
    border-radius: 999px;
    background: color-mix(in srgb, var(--text) 8%, transparent);
    box-shadow: inset 0 1px 0 var(--glass-rim);
    opacity: 0;
    transition:
      transform 0.65s var(--spring),
      width 0.65s var(--spring),
      opacity 0.3s ease;
  }

  .nav-indicator.is-visible {
    opacity: 1;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .menu-btn {
    display: none;
    position: relative;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .menu-btn span {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 1.75px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.5s var(--spring);
  }

  .menu-btn span:first-child {
    transform: translateY(-3.5px);
  }

  .menu-btn span:last-child {
    transform: translateY(3.5px);
  }

  .menu-btn[aria-expanded='true'] span:first-child {
    transform: rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] span:last-child {
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: var(--gutter);
    right: var(--gutter);
    padding: 0.75rem;
    border-radius: var(--radius-lg);
    background: var(--glass-strong);
    -webkit-backdrop-filter: blur(40px) saturate(180%);
    backdrop-filter: blur(40px) saturate(180%);
    box-shadow:
      inset 0 1px 0 var(--glass-rim),
      var(--shadow-lg);
    pointer-events: auto;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px) scale(0.96);
    transform-origin: top center;
    transition:
      opacity 0.25s ease,
      transform 0.5s var(--spring),
      visibility 0s linear 0.5s;
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.25s ease,
      transform 0.55s var(--spring),
      visibility 0s;
  }

  .mobile-menu ul {
    list-style: none;
  }

  .mobile-menu a {
    display: block;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.3s ease,
      transform 0.5s var(--spring),
      background-color 0.2s ease;
  }

  .mobile-menu a:hover {
    background: var(--surface-2);
  }

  .mobile-menu.is-open a {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 35ms + 60ms);
  }

  @media (max-width: 820px) {
    .nav {
      width: 100%;
    }

    .nav-links-wrap {
      display: none;
    }

    .menu-btn {
      display: block;
    }
  }

  @media (min-width: 821px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
