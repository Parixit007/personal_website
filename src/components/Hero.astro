---
import fs from 'node:fs';
import path from 'node:path';
import Ghost from './Ghost.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

// The résumé button appears only when public/resume.pdf exists.
const hasResume = fs.existsSync(path.join(process.cwd(), 'public', 'resume.pdf'));
const titleWords = ['Hi,', 'I’m', `${site.firstName}.`];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="aurora" aria-hidden="true">
    <span class="blob b1"></span>
    <span class="blob b2"></span>
    <span class="blob b3"></span>
    <span class="blob b4"></span>
  </div>

  <div class="hero-inner container">
    <div class="hero-ghost" data-ghost-stage>
      <div class="ghost-parallax">
        <div class="ghost-float">
          <Ghost size={168} interactive />
        </div>
      </div>
      <span class="ghost-shadow" aria-hidden="true"></span>
    </div>

    <a class="status glass" href="#contact">
      <span class="status-dot" aria-hidden="true"></span>
      <span>{site.status}</span>
      <Icon name="arrow-right" />
    </a>

    <h1 class="hero-title" id="hero-title">
      {
        titleWords.map((word, i) => (
          <>
            <span class="w" style={`--i:${i}`}>
              {word}
            </span>{' '}
          </>
        ))
      }
    </h1>

    <p class="hero-sub">
      I build <span class="gradient-text">agentic AI</span>, computer vision pipelines and developer tools.
    </p>

    <p class="hero-meta">B.Tech CSE · South Asian University · New Delhi</p>

    <div class="hero-cta">
      <a class="btn btn-primary" href="#work">
        See my work
        <Icon name="arrow-down" />
      </a>
      {
        hasResume ? (
          <a class="btn btn-glass" href="/resume.pdf" target="_blank" rel="noopener">
            <Icon name="file" />
            Résumé
          </a>
        ) : (
          <a class="btn btn-glass" href="#contact">
            Get in touch
          </a>
        )
      }
      <div class="hero-socials">
        <a class="btn btn-glass icon-btn" href={site.socials.github} target="_blank" rel="noopener" aria-label="GitHub">
          <Icon name="github" />
        </a>
        <a
          class="btn btn-glass icon-btn"
          href={site.socials.linkedin}
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
        >
          <Icon name="linkedin" />
        </a>
      </div>
    </div>
  </div>

  <a class="scroll-cue" href="#about" aria-label="Scroll to About"><span></span></a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding-block: calc(var(--nav-top) + 54px + 2.5rem) 5.5rem;
    overflow: clip;
    view-timeline: --hero block;
  }

  /* ---------- Aurora ---------- */

  .aurora {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.85;
    -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent 98%);
    mask-image: linear-gradient(to bottom, #000 50%, transparent 98%);
    animation: fade-in 2.4s ease both;
  }

  :global([data-theme='light']) .aurora {
    opacity: 0.6;
  }

  .blob {
    position: absolute;
    left: 50%;
    top: 30%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--c), transparent);
    will-change: transform;
  }

  .b1 {
    --c: rgba(255, 69, 58, 0.55);
    width: min(70vw, 820px);
    aspect-ratio: 1;
    translate: -78% -55%;
    animation: drift-a 19s ease-in-out infinite alternate;
  }

  .b2 {
    --c: rgba(255, 159, 10, 0.4);
    width: min(60vw, 700px);
    aspect-ratio: 1;
    translate: -10% -60%;
    animation: drift-b 23s ease-in-out infinite alternate;
  }

  .b3 {
    --c: rgba(255, 55, 95, 0.38);
    width: min(55vw, 640px);
    aspect-ratio: 1;
    translate: -50% -20%;
    animation: drift-c 27s ease-in-out infinite alternate;
  }

  .b4 {
    --c: rgba(191, 90, 242, 0.28);
    width: min(50vw, 560px);
    aspect-ratio: 1;
    translate: 10% -10%;
    animation: drift-a 31s ease-in-out infinite alternate-reverse;
  }

  @keyframes drift-a {
    to {
      transform: translate3d(12%, 10%, 0) scale(1.15);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate3d(-14%, 12%, 0) scale(0.9);
    }
  }

  @keyframes drift-c {
    to {
      transform: translate3d(8%, -14%, 0) scale(1.2);
    }
  }

  /* ---------- Content ---------- */

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-ghost {
    margin-bottom: 1.75rem;
    animation: ghost-in 1.4s var(--spring-bouncy) 0.1s both;
  }

  .ghost-float {
    animation: float 6s ease-in-out infinite;
  }

  .ghost-parallax {
    transform: rotate(var(--lean, 0deg));
    transition: transform 0.8s var(--spring);
  }

  .ghost-shadow {
    display: block;
    width: 96px;
    height: 14px;
    margin: 4px auto 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(120, 20, 20, 0.28), transparent);
    animation: shadow 6s ease-in-out infinite;
  }

  :global([data-theme='dark']) .ghost-shadow {
    background: radial-gradient(closest-side, rgba(255, 69, 58, 0.45), transparent);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 38px;
    padding: 0 0.95rem 0 0.85rem;
    margin-bottom: 1.75rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--text);
    box-shadow:
      inset 0 1px 0 var(--glass-rim),
      var(--shadow-sm);
    animation: rise 1s var(--ease-out) 0.35s both;
    transition: transform 0.5s var(--spring);
  }

  .status:hover {
    transform: scale(1.03);
  }

  .status :global(svg) {
    width: 14px;
    height: 14px;
    color: var(--text-3);
    transition: transform 0.5s var(--spring);
  }

  .status:hover :global(svg) {
    transform: translateX(3px);
  }

  .status-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--live);
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--live);
    animation: ping 2.2s var(--ease-out) infinite;
  }

  .hero-title {
    font-size: var(--fs-display);
    line-height: 0.98;
    letter-spacing: -0.05em;
    font-weight: 700;
  }

  .hero-title .w {
    display: inline-block;
    animation: rise-blur 1.1s var(--ease-out) calc(0.45s + var(--i) * 0.1s) both;
  }

  .hero-sub {
    max-width: 30ch;
    margin-top: 1.25rem;
    font-size: clamp(1.375rem, 0.95rem + 1.7vw, 2.25rem);
    line-height: 1.18;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-2);
    text-wrap: balance;
    animation: rise-blur 1.1s var(--ease-out) 0.8s both;
  }

  .hero-meta {
    margin-top: 1.25rem;
    text-wrap: balance;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    animation: rise 1s var(--ease-out) 0.95s both;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
    animation: rise 1s var(--ease-out) 1.05s both;
  }

  .hero-socials {
    display: flex;
    gap: 0.75rem;
  }

  .scroll-cue {
    position: absolute;
    bottom: 28px;
    left: 50%;
    width: 26px;
    height: 42px;
    margin-left: -13px;
    border-radius: 999px;
    border: 1.5px solid var(--line-strong);
    animation: fade-in 1s ease 1.6s both;
  }

  .scroll-cue span {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--text-2);
    animation: cue 2.2s var(--ease-in-out) infinite;
  }

  @media (pointer: coarse), (max-height: 700px) {
    .scroll-cue {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero-ghost :global(.ghost) {
      --size: 128px !important;
    }

    .hero-cta .btn-primary,
    .hero-cta > .btn-glass {
      flex: 1 1 100%;
    }
  }

  /* ---------- Scroll-linked exit (progressive enhancement) ---------- */

  @supports (animation-timeline: view()) {
    .hero-inner {
      animation: hero-out linear both;
      animation-timeline: --hero;
      animation-range: exit 0% exit 80%;
    }

    .ghost-parallax {
      animation: ghost-up linear both;
      animation-timeline: --hero;
      animation-range: exit 0% exit 100%;
    }
  }

  /* No filter here: a filtered ancestor would stop the status pill's glass from blurring the aurora. */
  @keyframes hero-out {
    to {
      opacity: 0;
      transform: translateY(-6vh) scale(0.94);
    }
  }

  @keyframes ghost-up {
    to {
      translate: 0 -18vh;
    }
  }

  /* ---------- Keyframes ---------- */

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @keyframes rise-blur {
    from {
      opacity: 0;
      transform: translateY(0.35em);
      filter: blur(12px);
    }
  }

  @keyframes ghost-in {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.4);
      filter: blur(14px);
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-14px) rotate(2deg);
    }
  }

  @keyframes shadow {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.75);
      opacity: 0.55;
    }
  }

  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    80%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  @keyframes cue {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    70% {
      transform: translateY(12px);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
</style>
