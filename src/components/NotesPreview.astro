---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { formatDate, readingTime, type Note } from '../lib/notes';

interface Props {
  notes: Note[];
  num: string;
}

const { notes, num } = Astro.props;
const latest = notes.slice(0, 3);
---

<section class="section notes" id="notes" aria-labelledby="notes-title">
  <div class="container">
    <SectionHeading
      num={num}
      eyebrow="Notes"
      id="notes-title"
      title="Notes."
      muted="Thoughts and things I’m learning along the way."
    />

    <div class="notes-grid">
      {
        latest.map((note, i) => (
          <a class="note card" href={`/notes/${note.id}/`} data-reveal data-spotlight style={`--d:${i * 80}`}>
            <p class="note-meta">
              <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date, 'short')}</time>
              <span>·</span>
              <span>{readingTime(note.body)}</span>
              {note.data.draft && <span class="draft">Draft</span>}
            </p>
            <h3 class="note-title">{note.data.title}</h3>
            <p class="note-desc">{note.data.description}</p>
            <span class="link-arrow">
              Read <Icon name="arrow-right" />
            </span>
          </a>
        ))
      }
    </div>

    <a class="all btn btn-glass" href="/notes/" data-reveal>
      All notes <Icon name="arrow-right" />
    </a>
  </div>
</section>

<style>
  .notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }

  .note {
    display: flex;
    flex-direction: column;
    min-height: 240px;
    padding: 1.75rem;
    transition:
      transform 0.6s var(--spring),
      border-color 0.3s ease;
  }

  .note:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
  }

  .note-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .draft {
    margin-left: 0.25rem;
    padding: 0 0.45rem;
    border-radius: 999px;
    color: var(--accent);
    background: var(--accent-soft);
  }

  .note-title {
    margin-top: 1rem;
    font-size: var(--fs-xl);
    letter-spacing: -0.03em;
  }

  .note-desc {
    margin-top: 0.5rem;
    color: var(--text-2);
  }

  .note .link-arrow {
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .note:hover .link-arrow :global(svg) {
    transform: translateX(3px);
  }

  .all {
    margin-top: 2rem;
  }
</style>
