---
// A tiny editor: one highlight cycles through the extension's six colours (⌘⇧H),
// then a line is inserted above and every highlight moves with its code.
---

<div class="hlv" data-play aria-hidden="true">
  <div class="editor">
    <div class="bar">
      <span class="lights"><i></i><i></i><i></i></span>
      <span class="tab is-active">cart.ts</span>
      <span class="tab">highlight.json</span>
    </div>
    <div class="body">
      <div class="gutter">
        {Array.from({ length: 9 }, (_, i) => <span>{i + 1}</span>)}
      </div>
      <div class="code">
        <div class="ln ins"><span class="c">// coupons? later.</span></div>
        <div class="ln">
          <span class="k">export function</span> <span class="f">total</span>(<span class="v">items</span>: <span
            class="t">Item</span
          >[]) {'{'}
        </div>
        <div class="ln hl hl-yellow">
          &nbsp;&nbsp;<span class="k">const</span> <span class="v">sub</span> = <span class="v">items</span>.<span
            class="f">reduce</span
          >(<span class="v">sum</span>, <span class="n">0</span>);
        </div>
        <div class="ln hl hl-cycle">
          &nbsp;&nbsp;<span class="k">const</span> <span class="v">tax</span> = <span class="v">sub</span> * <span
            class="v">TAX</span
          >;
        </div>
        <div class="ln">&nbsp;&nbsp;<span class="k">return</span> <span class="v">sub</span> + <span class="v">tax</span>;</div>
        <div class="ln">{'}'}</div>
        <div class="ln">&nbsp;</div>
        <div class="ln hl hl-pink">
          <span class="k">export const</span> <span class="v">TAX</span> = <span class="n">0.18</span>;
        </div>
      </div>
    </div>
  </div>
  <div class="kbd"><kbd>⌘</kbd><kbd>⇧</kbd><kbd>H</kbd></div>
  <div class="saved"><i></i>highlight.json · 3 highlights</div>
</div>

<style>
  .hlv {
    position: relative;
    height: 100%;
    overflow: hidden;
    container-type: inline-size;
    background:
      radial-gradient(90% 80% at 80% 0%, rgba(10, 132, 255, 0.22), transparent 60%),
      radial-gradient(70% 70% at 0% 100%, rgba(255, 55, 145, 0.16), transparent 60%);
  }

  .editor {
    position: absolute;
    top: 28px;
    left: 28px;
    right: -40px;
    bottom: -40px;
    border-radius: 14px;
    background: #1b1b1f;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 30px 60px -20px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
    color: #d4d4d4;
    letter-spacing: 0;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 36px;
    padding: 0 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-family: var(--font-sans);
    font-size: 11.5px;
    color: #8b8b93;
  }

  .lights {
    display: flex;
    gap: 6px;
  }

  .lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  .tab.is-active {
    color: #e8e8ea;
  }

  .body {
    display: flex;
    padding: 10px 0;
  }

  .gutter {
    display: flex;
    flex-direction: column;
    width: 38px;
    padding-right: 12px;
    text-align: right;
    color: #55555d;
    flex: none;
  }

  .code {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
  }

  .ln {
    height: 1.75em;
    padding-left: 10px;
    border-left: 2px solid transparent;
  }

  .ins {
    height: 0;
    opacity: 0;
    overflow: hidden;
  }

  .hl {
    --hc: 255, 214, 10;
    background: linear-gradient(90deg, rgba(var(--hc), 0.3), rgba(var(--hc), 0.12));
    border-left-color: rgb(var(--hc));
  }

  .hl-yellow {
    --hc: 255, 214, 10;
  }

  .hl-pink {
    --hc: 255, 55, 145;
  }

  .hl-cycle {
    --hc: 10, 132, 255;
  }

  .k {
    color: #c586c0;
  }

  .f {
    color: #dcdcaa;
  }

  .v {
    color: #9cdcfe;
  }

  .t {
    color: #4ec9b0;
  }

  .n {
    color: #b5cea8;
  }

  .c {
    color: #6a9955;
  }

  .kbd {
    position: absolute;
    right: 20px;
    top: 72px;
    display: flex;
    gap: 4px;
  }

  kbd {
    display: grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    padding: 0 6px;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    background: rgba(40, 40, 46, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      inset 0 -2px 0 rgba(0, 0, 0, 0.35),
      0 6px 16px rgba(0, 0, 0, 0.3);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .saved {
    position: absolute;
    right: 20px;
    bottom: 20px;
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 600;
    color: #fff;
    background: rgba(30, 30, 34, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.12);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .saved i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #30d158;
  }

  /* Narrow cards: the keycaps would sit on top of the code. */
  @container (max-width: 480px) {
    .kbd {
      display: none;
    }
  }

  /* ---------- The loop (10s) ---------- */

  .is-playing .hl-cycle {
    animation: cycle 10s steps(1, end) infinite;
  }

  .is-playing kbd {
    animation: press 10s ease infinite;
  }

  .is-playing .ins {
    animation: insert 10s var(--ease-out) infinite;
  }

  .is-playing .saved {
    animation: saved 10s var(--ease-out) infinite;
  }

  /* One ⌘⇧H press per colour, settling on blue so it stands apart from its yellow neighbour. */
  @keyframes cycle {
    0% {
      --hc: 255, 69, 58;
    }
    10% {
      --hc: 48, 209, 88;
    }
    20% {
      --hc: 255, 55, 145;
    }
    30% {
      --hc: 100, 210, 255;
    }
    40% {
      --hc: 255, 214, 10;
    }
    50%,
    100% {
      --hc: 10, 132, 255;
    }
  }

  @keyframes press {
    0%,
    8%,
    18%,
    28%,
    38%,
    48%,
    100% {
      transform: none;
      box-shadow:
        inset 0 -2px 0 rgba(0, 0, 0, 0.35),
        0 6px 16px rgba(0, 0, 0, 0.3);
    }
    9.5%,
    19.5%,
    29.5%,
    39.5%,
    49.5% {
      transform: translateY(2px) scale(0.94);
      box-shadow:
        inset 0 -1px 0 rgba(0, 0, 0, 0.35),
        0 2px 6px rgba(0, 0, 0, 0.3);
    }
  }

  @keyframes insert {
    0%,
    58% {
      height: 0;
      opacity: 0;
    }
    64%,
    92% {
      height: 1.75em;
      opacity: 1;
    }
    98%,
    100% {
      height: 0;
      opacity: 0;
    }
  }

  @keyframes saved {
    0%,
    66% {
      opacity: 0;
      transform: translateY(10px) scale(0.9);
    }
    71%,
    92% {
      opacity: 1;
      transform: none;
    }
    97%,
    100% {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>
